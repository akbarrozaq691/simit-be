# Copy to .env and fill in the blanks. Every key maps to a field on Settings in
# src/settings.py — the defaults there apply to whatever you leave out.
# .env is gitignored; this file is committed, so keep real secrets out of it.

# ---- App ----
APP_NAME=simit-be
ENV=development
DEBUG=true
APP_PORT=8888
API_PREFIX=/v1/api

# ---- Auth ----
# Generate your own. Changing it invalidates every issued token, so everyone
# signs in again.
JWT_SECRET_KEY=change-me-in-prod
JWT_EXPIRE_MINUTES=1440

# ---- Postgres ----
# docker-compose overrides POSTGRES_HOST to "postgres" for the app container;
# this value is what a process running on the host uses.
# The password must match the one the database volume was initialised with —
# changing it here does not change the password stored in Postgres, so a
# mismatch shows up as the app failing to connect.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=simit
POSTGRES_USER=simit
POSTGRES_PASSWORD=changeme

# ---- SMTP (pipeline notification emails to EIC/SC/author) ----
# An empty host skips sending rather than failing the request that triggered it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@simit.local
# Display name recipients see. Kept separate from SMTP_FROM because that
# value is also the envelope sender, which must stay a bare address —
# mail servers verify it and refuse a sender they cannot match.
SMTP_FROM_NAME=

# ---- Storage (S3-compatible: IDCloudHost, AWS S3, MinIO, Cloudflare R2, ...) ----
# Uploads are addressed as {STORAGE_BASE_URL}/{STORAGE_BUCKET}/{key}, so the
# base URL carries the scheme and no trailing slash.
# Leave these empty and every upload answers 500 with "storage is not
# configured" — including paper submission, not just landing-page images.
STORAGE_BASE_URL=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Ceph-backed endpoints want a real region name. "auto" only works on
# Cloudflare R2; elsewhere it makes signature verification fail.
STORAGE_REGION=us-east-1

# ---- Uploads ----
# Applies to both papers and images.
MAX_UPLOAD_MB=10
